{
  "permissions": {
    "allow": [
      "Bash(scripts/verify.sh)",
      "Bash(scripts/spec-lint.sh)",
      "Bash(scripts/build.sh:*)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(gofmt:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks/session-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks/guard-destructive.sh\" claude",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks/commit-reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
