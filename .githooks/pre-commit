#!/bin/sh
# Installed by `make hooks` (git config core.hooksPath .githooks). Runs for
# people, Kiro and Claude Code alike. See AGENTS.md "Guardrails".
command -v gitleaks >/dev/null 2>&1 ||
  echo 'pre-commit: gitleaks not installed, secrets not checked here (CI checks them): brew install gitleaks' >&2
out=$(sh scripts/checks/staged.sh) && exit 0
printf 'pre-commit: blocked\n%s\n' "$out" >&2
exit 1
